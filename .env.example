# Postgres connection (POSTGRES_URL also works, as set by Vercel's Supabase integration). On Supabase use the pooler URL in transaction mode (port 6543) for the API,
# and the direct or session URL (port 5432) for `npm run db:migrate`.
# On Supabase the API should connect as its own login, meridian_api (db/supabase/setup.sql step 3);
# migrations run as postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# 32 random bytes, base64. Encrypts webhook signing secrets at rest.  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# The public address of this deployment (used for links and the sandbox's demo webhook receiver).
PUBLIC_BASE_URL=http://localhost:8787
# Shared secret for /internal/tick, the every-minute job that sends webhooks. On Vercel, Vercel Cron
# (vercel.json) sends it automatically. Without Vercel Cron, the Supabase pg_cron job in
# db/supabase/setup.sql uses a secret kept in Vault instead.  openssl rand -hex 32
CRON_SECRET=
# Supabase project: storage for résumés and verification of login tokens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs logins with the legacy shared secret.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=resumes
