# Postgres connection. On Supabase use the pooler URL in transaction mode (port 6543) for the API,
# and the direct or session URL (port 5432) for `npm run db:migrate`.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# 32 random bytes, base64. Encrypts webhook signing secrets at rest.  openssl rand -base64 32
APP_ENCRYPTION_KEY=
# The public address of this deployment (used for links and the sandbox's demo webhook receiver).
PUBLIC_BASE_URL=http://localhost:8787
# Shared secret for /internal/tick (called by Supabase pg_cron every minute and by Vercel Cron).
CRON_SECRET=
# Supabase project: storage for résumés and verification of login tokens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the project still signs logins with the legacy shared secret.
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=resumes
